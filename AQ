import pandas as pd
from sklearn.linear_model import LinearRegression
import matplotlib.pyplot as plt
import seaborn as sns

# 🔥 LIFE SAVER: Semicolon separator
df = pd.read_csv("AirQuality.csv", sep=";")

# 1. Data Cleaning (Khali faltu columns ko hatana)
df.drop(columns=['Unnamed: 15', 'Unnamed: 16'], inplace=True, errors='ignore')

# 2. Data Cleaning (Baaki NaN values ko average se bharna)
# (numeric_only=True zaroori hai varna date wale column mein error aayega)
df.fillna(df.mean(numeric_only=True), inplace=True)

# 3. Data Visualization (Temperature 'T' vs Absolute Humidity 'AH' ka graph)
sns.scatterplot(x='T', y='AH', data=df)
plt.title("Temperature vs Absolute Humidity")
plt.show()

# 4. Data Model Building (Predict AH using Temp and Relative Humidity)
X = df[['T', 'RH']] # Inputs
y = df['AH']        # Target

model = LinearRegression()
model.fit(X, y)
predictions = model.predict(X)
print("Air Quality Predictions:", predictions[:5])
