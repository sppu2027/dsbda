import pandas as pd

# 1. Load the dataset (Semicolon separated)
df = pd.read_csv('dataset_Facebook.csv', sep=';')

print("Original Data Shape:", df.shape)

# a. Create Data Subsets (Subsetting based on 'Type' of post)
photo_subset = df[df['Type'] == 'Photo']
video_subset = df[df['Type'] == 'Video']
print("\n--- Subsets Created ---")
print(f"Photos subset shape: {photo_subset.shape}")

# b. Merge Data 
# (Creating dummy IDs to demonstrate merging since real data is single table)
subset1 = df[['Type', 'Category', 'Post Month']].iloc[:50]
subset2 = df[['Type', 'like', 'share']].iloc[:50]
# Merging on index to show the operation
merged_data = pd.merge(subset1, subset2, left_index=True, right_index=True)
print("\n--- Merged Data Head ---")
print(merged_data.head(3))

# c. Sort Data (Sorting by most likes)
sorted_data = df.sort_values(by='like', ascending=False)
print("\n--- Data Sorted by Likes (Top 3) ---")
print(sorted_data[['Type', 'like']].head(3))

# d. Transposing Data
transposed_data = df.head(5).transpose() # Transposing only first 5 rows for clean output
print("\n--- Transposed Data ---")
print(transposed_data)

# e. Shape and Reshape Data
print("\n--- Shape of original data ---:", df.shape)

# Reshaping using melt
melted_df = pd.melt(df, id_vars=['Type', 'Category'], value_vars=['like', 'share', 'comment'])
print("\n--- Reshaped Data (Melted) ---")
print(melted_df.head())
